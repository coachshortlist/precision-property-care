# Copy these into Vercel (Project > Settings > Environment Variables) or Netlify (Site configuration > Environment variables). Never commit real values.

# From Supabase: Project Settings > API (or Data API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=the-secret-service-role-key
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=the-public-anon-key

# Optional: new-lead email alerts via resend.com
RESEND_API_KEY=
ALERT_EMAIL=you@example.com
ALERT_FROM=Website enquiries <onboarding@resend.dev>

# Optional: set once the real domain is connected, e.g. https://www.precisionpropertycare.co.uk
SITE_URL=
